<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center">

    <TextView
        android:id="@+id/textCalibInstruction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Place the phone in its vehicle mount and keep the vehicle completely stationary."
        android:textColor="@color/textSecondary"
        android:textSize="14sp"
        android:gravity="center"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/textCalibStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Ready to calibrate"
        android:textColor="@color/textPrimary"
        android:textSize="16sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="16dp" />

    <ProgressBar
        android:id="@+id/progressCalib"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/buttonCalibAction"
        style="@style/ModernButton"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:text="Start Calibration" />

</LinearLayout>
