<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="4dp"
        android:background="@color/colorPrimary">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <ImageView
                android:id="@+id/buttonCloseSensors"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_arrow_back"
                app:tint="@android:color/white"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:text="Sensor Data"
                android:textColor="@android:color/white"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_live_badge"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp">

                <View
                    android:layout_width="10dp"
                    android:layout_height="10dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/circle_background"
                    android:backgroundTint="#00E676" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="LIVE"
                    android:textColor="@android:color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Virtual Speedometer Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="4dp"
                app:cardBackgroundColor="@color/colorPrimary"
                app:strokeWidth="0dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="VIRTUAL SPEEDOMETER"
                        android:textSize="12sp"
                        android:textColor="@android:color/white"
                        android:alpha="0.8"
                        android:textStyle="bold"
                        android:letterSpacing="0.1" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="bottom"
                        android:layout_marginTop="8dp">

                        <TextView
                            android:id="@+id/textVirtualSpeed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0.0"
                            android:textSize="56sp"
                            android:textColor="@android:color/white"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="km/h"
                            android:textSize="18sp"
                            android:textColor="@android:color/white"
                            android:alpha="0.7"
                            android:layout_marginStart="8dp"
                            android:layout_marginBottom="12dp" />
                    </LinearLayout>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/speedProgress"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:max="200"
                        android:progress="0"
                        app:trackColor="#40FFFFFF"
                        app:indicatorColor="@android:color/white"
                        app:trackThickness="8dp"
                        app:trackCornerRadius="4dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Accelerometer Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E0E0E0">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/ic_axis" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="ACCELEROMETER"
                                android:textSize="15sp"
                                android:textColor="@android:color/black"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Linear acceleration"
                                android:textSize="13sp"
                                android:textColor="#757575" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="m/s²"
                            android:textSize="14sp"
                            android:textColor="#757575" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal"
                        android:baselineAligned="false"
                        android:weightSum="3">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="@drawable/bg_sensor_value"
                            android:gravity="center"
                            android:paddingVertical="10dp"
                            android:layout_marginEnd="6dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="X" android:textColor="#F44336" android:textStyle="bold" />
                            <TextView android:id="@+id/textAccX" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.00" android:textSize="20sp" android:textColor="@android:color/black" android:textStyle="bold" android:layout_marginTop="2dp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="m/s²" android:textSize="11sp" android:textColor="#9E9E9E" android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="@drawable/bg_sensor_value"
                            android:gravity="center"
                            android:paddingVertical="10dp"
                            android:layout_marginHorizontal="3dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Y" android:textColor="#4CAF50" android:textStyle="bold" />
                            <TextView android:id="@+id/textAccY" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.00" android:textSize="20sp" android:textColor="@android:color/black" android:textStyle="bold" android:layout_marginTop="2dp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="m/s²" android:textSize="11sp" android:textColor="#9E9E9E" android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="@drawable/bg_sensor_value"
                            android:gravity="center"
                            android:paddingVertical="10dp"
                            android:layout_marginStart="6dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Z" android:textColor="#2196F3" android:textStyle="bold" />
                            <TextView android:id="@+id/textAccZ" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.00" android:textSize="20sp" android:textColor="@android:color/black" android:textStyle="bold" android:layout_marginTop="2dp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="m/s²" android:textSize="11sp" android:textColor="#9E9E9E" android:layout_marginTop="2dp" />
                        </LinearLayout>

                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/layoutAccGraph"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:layout_marginTop="16dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Gyroscope Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="#E0E0E0">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/ic_gyro" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginStart="16dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="GYROSCOPE"
                                android:textSize="15sp"
                                android:textColor="@android:color/black"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Angular velocity"
                                android:textSize="13sp"
                                android:textColor="#757575" />
                        </LinearLayout>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="rad/s"
                            android:textSize="14sp"
                            android:textColor="#757575" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal"
                        android:baselineAligned="false"
                        android:weightSum="3">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="@drawable/bg_sensor_value"
                            android:gravity="center"
                            android:paddingVertical="10dp"
                            android:layout_marginEnd="6dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="X" android:textColor="#F44336" android:textStyle="bold" />
                            <TextView android:id="@+id/textGyroX" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.00" android:textSize="20sp" android:textColor="@android:color/black" android:textStyle="bold" android:layout_marginTop="2dp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="rad/s" android:textSize="11sp" android:textColor="#9E9E9E" android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="@drawable/bg_sensor_value"
                            android:gravity="center"
                            android:paddingVertical="10dp"
                            android:layout_marginHorizontal="3dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Y" android:textColor="#4CAF50" android:textStyle="bold" />
                            <TextView android:id="@+id/textGyroY" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.00" android:textSize="20sp" android:textColor="@android:color/black" android:textStyle="bold" android:layout_marginTop="2dp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="rad/s" android:textSize="11sp" android:textColor="#9E9E9E" android:layout_marginTop="2dp" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:background="@drawable/bg_sensor_value"
                            android:gravity="center"
                            android:paddingVertical="10dp"
                            android:layout_marginStart="6dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Z" android:textColor="#2196F3" android:textStyle="bold" />
                            <TextView android:id="@+id/textGyroZ" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0.00" android:textSize="20sp" android:textColor="@android:color/black" android:textStyle="bold" android:layout_marginTop="2dp" />
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="rad/s" android:textSize="11sp" android:textColor="#9E9E9E" android:layout_marginTop="2dp" />
                        </LinearLayout>

                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/layoutGyroGraph"
                        android:layout_width="match_parent"
                        android:layout_height="180dp"
                        android:layout_marginTop="16dp" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</LinearLayout>
