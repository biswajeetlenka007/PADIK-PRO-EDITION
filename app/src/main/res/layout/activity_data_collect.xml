<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/navBackground"
    android:orientation="vertical">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:theme="@style/ThemeOverlay.AppCompat.Dark.ActionBar">
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/topToolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@color/navSurface"
            app:title="Data Logger"
            app:titleTextColor="@color/navTextPrimary"
            app:navigationIcon="@drawable/ic_arrow_back"
            app:navigationIconTint="@color/navTextPrimary" />
    </com.google.android.material.appbar.AppBarLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="20dp">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/navSurface"
            app:cardCornerRadius="16dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:id="@+id/textRecordingStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Recording: OFF"
                    android:textColor="@color/navAccent"
                    android:textSize="20sp"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/textImuCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/navTextSecondary"
                            android:text="IMU Samples: 0"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/textGnssCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/navTextSecondary"
                            android:text="GNSS Samples: 0"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/textMotionMode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/navTextSecondary"
                            android:text="Motion: STATIONARY"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                        <TextView
                            android:id="@+id/textGnssAccuracy"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/navTextSecondary"
                            android:text="GNSS Accuracy: --"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/textGnssSpeed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/navTextSecondary"
                            android:text="GNSS Speed: --"
                            android:textSize="14sp" />

                        <TextView
                            android:id="@+id/textCurrentHeading"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/navTextSecondary"
                            android:text="Heading: --"
                            android:textSize="14sp" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Raw Output"
            android:textColor="@color/navAccent"
            android:layout_marginTop="20dp"
            android:textStyle="bold"
            android:textSize="14sp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:background="@color/navSurfaceElevated"
            android:padding="12dp">
            <TextView
                android:id="@+id/textDataCollect"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/navTextSecondary"
                android:textSize="12sp"
                android:fontFamily="monospace"
                android:text="" />
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="20dp"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonDataStart"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                app:cornerRadius="28dp"
                android:text="@string/start" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonDataPause"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_marginHorizontal="12dp"
                android:layout_weight="1"
                app:cornerRadius="28dp"
                app:strokeColor="@color/navDivider"
                android:textColor="@color/navTextPrimary"
                android:text="@string/pause" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonDataStop"
                style="@style/Widget.MaterialComponents.Button"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                app:cornerRadius="28dp"
                app:backgroundTint="@color/navError"
                android:text="@string/stop" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
